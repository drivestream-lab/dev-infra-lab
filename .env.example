# dev-infra-lab — copy to .env (gitignored). Do not commit secrets.
# Shared local-dev lab: Postgres · Redis · LiteLLM on network lab_local.

POSTGRES_USER=adh
POSTGRES_PASSWORD=adh
POSTGRES_DB=adh

# LiteLLM Admin UI + OpenAI-compatible API — http://localhost:4000
LITELLM_MASTER_KEY=sk-adh-local-master
LITELLM_SALT_KEY=adh-local-salt-change-me
LITELLM_POSTGRES_DB=litellm
UI_USERNAME=adh-admin
UI_PASSWORD=adh-admin
# OpenRouter — required to call glm / qwen / kimi-k3 / sonnet. Never commit the value.
OPENROUTER_API_KEY=

# Platform services (make platform-up). Local defaults; the copy lives in gitignored .env.
# Temporal connects as role temporal. Paperclip connects as role paperclip.
# mandate_owner is migrations only. mandate_app is the runtime role.
TEMPORAL_DB_PASSWORD=temporal
PAPERCLIP_DB_PASSWORD=paperclip
MANDATE_DB_OWNER_PASSWORD=mandate_owner
MANDATE_DB_APP_PASSWORD=mandate_app
BETTER_AUTH_SECRET=local-better-auth-secret-change-me
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=local-tool-action-signing-secret
